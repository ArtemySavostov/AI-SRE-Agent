# Copy to .env and pass it to the backend container via Compose env_file.
# Spring Boot does not load .env automatically.
SERVER_PORT=8080

# Docker service name and INTERNAL PostgreSQL port, not the published host port.
DB_HOST=postgres
DB_PORT=5432
DB_NAME=sre_platform
DB_USERNAME=sre_platform
DB_PASSWORD=replace_with_your_local_password

# In the PostgreSQL container, map these same values explicitly:
# POSTGRES_DB <- DB_NAME
# POSTGRES_USER <- DB_USERNAME
# POSTGRES_PASSWORD <- DB_PASSWORD
# Do not pass database credentials to the frontend container or VITE_* variables.

# No Flyway migrations exist yet. For a disposable development database ONLY,
# uncomment both lines to let Hibernate create/update tables from the entities:
# SPRING_JPA_HIBERNATE_DDL_AUTO=update
# SPRING_FLYWAY_ENABLED=false
# Once versioned migrations are added, remove both overrides.
