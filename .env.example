# Root Compose environment. Copy to .env and replace the password.
DB_NAME=sre_platform
DB_USERNAME=sre_platform
DB_PASSWORD=replace_with_your_local_password

# Published host ports. Container ports remain 8080 and 5173.
BACKEND_PORT=8080
FRONTEND_PORT=5173

# Development bootstrap only: this project has no Flyway migrations yet.
# After adding versioned migrations, use validate and true respectively.
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_FLYWAY_ENABLED=false
